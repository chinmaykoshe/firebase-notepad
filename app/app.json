{
  "expo": {
    "name": "Firebase Notepad",
    "slug": "fb-notepad",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "android": {
      "package": "com.freenote.notepad"
    },
    "plugins": [
      "expo-status-bar",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
